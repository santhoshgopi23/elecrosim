   "ds": "",
   "x": 60,
   "y": 98,
   "text": "Try: slave address 2 (other slave answers), function 06 (write), start register 50 (exception 02), quantity 0 or 200 (exception 03), MS1 \"device failure\" ON (exception 04), function 08 (exception 01).",
   "size": 12,
   "bold": 0,
   "it": 0,
